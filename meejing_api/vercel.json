{
  "builds": [
    {
      "src": "meejing_api/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "buildCommand": "python pip install -r requirements.txt && python manage.py collectstatic --noinput",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}

